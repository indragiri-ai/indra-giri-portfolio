# --- Hosting ---
# Custom domain (indragiri.com.np) is served from the root: leave base path empty.
# Only set it (e.g. /indra-giri-portfolio) when serving from a project subfolder.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://indragiri.com.np

# --- Formspree (contact form) ---
# Portfolio form: https://formspree.io/f/mrpepzrk (public ID, not a password).
# The form ID is the last segment of your endpoint: formspree.io/f/<FORM_ID>
NEXT_PUBLIC_FORMSPREE_ID=mrpepzrk
