# --- GitHub Pages ---
# Set to /your-repo-name for project pages (e.g. /indra-giri-portfolio).
# Leave empty for user/org pages (username.github.io).
NEXT_PUBLIC_BASE_PATH=/indra-giri-portfolio
# Full canonical site root, including the base path for GitHub project pages.
NEXT_PUBLIC_SITE_URL=https://indragiri-ai.github.io/indra-giri-portfolio

# --- Formspree (contact form) ---
# Portfolio form: https://formspree.io/f/mrpepzrk (public ID, not a password).
# The form ID is the last segment of your endpoint: formspree.io/f/<FORM_ID>
NEXT_PUBLIC_FORMSPREE_ID=mrpepzrk
